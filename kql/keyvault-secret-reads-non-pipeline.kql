// FAFO question: who, other than the pipeline, is reading the secrets that guard customer data?
// Key Vault holds the connection secrets for FAFO's analytics stores. A secret read by a
// person's account, or by a workload nobody approved, is the earliest signal of credential
// harvesting. Data source: Key Vault AuditEvent logs, routed to the workspace by the
// fafo-dine-keyvault-audit-logs policy (stage 01) in every governed subscription.
// 800-53: AC-6(9) log use of privileged functions, AU-6 audit review, SI-4 system monitoring.
//
// Placeholders (filled by stages/07-detection with templatefile; replace by hand to run ad hoc):
//   ${new_rows_filter}       alert rules: "| where ingestion_time() > ago(15m)"; ad hoc: delete the line
//   ${approved_reader_ids}   quoted, comma-separated object IDs allowed to read secrets
//                            (the pipeline identities plus any approved application identities)
AzureDiagnostics
${new_rows_filter}
| where ResourceProvider == "MICROSOFT.KEYVAULT" and Category == "AuditEvent"
| where OperationName in ("SecretGet", "SecretList", "SecretListVersions", "SecretBackup")
| extend CallerObjectId = tostring(identity_claim_http_schemas_microsoft_com_identity_claims_objectidentifier_g)
| extend CallerUpn = tostring(identity_claim_upn_s)
| where CallerObjectId !in (${approved_reader_ids})
| project TimeGenerated, Vault = Resource, OperationName, ResultSignature, CallerObjectId, CallerUpn, CallerIPAddress, _ResourceId, SubscriptionId
| order by TimeGenerated desc
