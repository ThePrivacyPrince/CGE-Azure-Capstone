{
  "schemaVersion": "2.0",
  "description": "FAFO Inc. collect-once crosswalk, federal track. The collector stores each platform finding exactly once; reports resolve findings to NIST SP 800-53 Rev. 5 controls through this file. Changing a mapping never requires re-collecting evidence. The collector uploads this file to the Cosmos 'mappings' container keyed by its SHA-256, and every run manifest records the version in force. Every control ID must resolve to a non-withdrawn control in frameworks/nist-800-53-rev5.json (tests/test_catalog.py).",
  "frameworks": {
    "nist_800_53_r5": {
      "name": "NIST SP 800-53 Rev. 5",
      "baseline": "NIST SP 800-53B Moderate",
      "catalog": "frameworks/nist-800-53-rev5.json"
    }
  },
  "severityDefaults": {
    "policy": "Medium"
  },
  "slaDays": {
    "High": 30,
    "Medium": 90,
    "Low": 180
  },
  "slaSource": "FedRAMP POA&M remediation timelines: High 30 days, Moderate 90, Low 180 (Medium here = Moderate).",
  "controls": [
    {
      "controlKey": "policy:cge-require-env-tag-rg",
      "title": "Resource groups carry an env tag (owner accountability)",
      "match": {
        "source": "policy",
        "policyDefinitionName": "cge-require-env-tag-rg"
      },
      "severity": "Low",
      "mappings": {
        "nist_800_53_r5": [
          "CM-8"
        ]
      }
    },
    {
      "controlKey": "policy:cge-deny-public-blob",
      "title": "Storage accounts deny public blob access",
      "match": {
        "source": "policy",
        "policyDefinitionName": "cge-deny-public-blob"
      },
      "severity": "High",
      "mappings": {
        "nist_800_53_r5": [
          "AC-3",
          "AC-6",
          "SC-7"
        ]
      }
    },
    {
      "controlKey": "policy:cge-dine-storage-diagnostics",
      "title": "Storage accounts route diagnostics to the GRC workspace",
      "match": {
        "source": "policy",
        "policyDefinitionName": "cge-dine-storage-diagnostics"
      },
      "severity": "Medium",
      "mappings": {
        "nist_800_53_r5": [
          "AU-2",
          "AU-12",
          "SI-4"
        ]
      }
    },
    {
      "controlKey": "policy:cge-fix-public-blob",
      "title": "Public blob access corrected by remediation identity",
      "match": {
        "source": "policy",
        "policyDefinitionName": "cge-fix-public-blob"
      },
      "severity": "High",
      "mappings": {
        "nist_800_53_r5": [
          "CM-6",
          "SI-2"
        ]
      }
    },
    {
      "controlKey": "policy:fafo-storage-min-tls12",
      "title": "Storage accounts require TLS 1.2 (PHI in transit)",
      "match": {
        "source": "policy",
        "policyDefinitionName": "fafo-storage-min-tls12"
      },
      "severity": "Medium",
      "mappings": {
        "nist_800_53_r5": [
          "SC-8",
          "SC-8(1)",
          "SC-13"
        ]
      }
    },
    {
      "controlKey": "policy:fafo-fix-min-tls",
      "title": "Corrective: storage minimum TLS set to 1.2",
      "match": {
        "source": "policy",
        "policyDefinitionName": "fafo-fix-min-tls"
      },
      "severity": "Medium",
      "mappings": {
        "nist_800_53_r5": [
          "CM-6",
          "SC-8(1)"
        ]
      }
    },
    {
      "controlKey": "policy:fafo-cosmos-no-local-auth",
      "title": "Cosmos DB rejects key-based auth (every data-plane call attributable)",
      "match": {
        "source": "policy",
        "policyDefinitionName": "fafo-cosmos-no-local-auth"
      },
      "severity": "High",
      "mappings": {
        "nist_800_53_r5": [
          "IA-2",
          "IA-5",
          "AC-2"
        ]
      }
    },
    {
      "controlKey": "policy:fafo-allowed-locations",
      "title": "Resources deploy only to approved US regions (data residency)",
      "match": {
        "source": "policy",
        "policyDefinitionName": "fafo-allowed-locations"
      },
      "severity": "Medium",
      "mappings": {
        "nist_800_53_r5": [
          "SA-9(5)",
          "CM-2"
        ]
      }
    },
    {
      "controlKey": "policy:fafo-keyvault-purge-protection",
      "title": "Key vaults have purge protection (keys guarding PHI cannot be destroyed early)",
      "match": {
        "source": "policy",
        "policyDefinitionName": "fafo-keyvault-purge-protection"
      },
      "severity": "High",
      "mappings": {
        "nist_800_53_r5": [
          "SC-12",
          "CP-9"
        ]
      }
    },
    {
      "controlKey": "policy:fafo-audit-subscription-owner",
      "title": "No standing Owner role assignments at subscription scope",
      "match": {
        "source": "policy",
        "policyDefinitionName": "fafo-audit-subscription-owner"
      },
      "severity": "High",
      "mappings": {
        "nist_800_53_r5": [
          "AC-6(5)",
          "AC-6(7)"
        ]
      }
    },
    {
      "controlKey": "policy:fafo-dine-keyvault-audit-logs",
      "title": "Key vault audit events route to the GRC workspace",
      "match": {
        "source": "policy",
        "policyDefinitionName": "fafo-dine-keyvault-audit-logs"
      },
      "severity": "Medium",
      "mappings": {
        "nist_800_53_r5": [
          "AU-2",
          "AU-6",
          "AU-12"
        ]
      }
    },
    {
      "controlKey": "defender:storage-public-access",
      "title": "Defender: storage account public access disallowed",
      "match": {
        "source": "defender",
        "assessmentName": "51fd8bb1-0db4-bbf1-7e2b-cfcba7eb66a6"
      },
      "mappings": {
        "nist_800_53_r5": [
          "AC-3",
          "SC-7",
          "CA-7"
        ]
      }
    },
    {
      "controlKey": "defender:storage-shared-key",
      "title": "Defender: storage accounts prevent shared key access",
      "match": {
        "source": "defender",
        "displayNameContains": "shared key access"
      },
      "mappings": {
        "nist_800_53_r5": [
          "IA-2",
          "AC-6"
        ]
      }
    },
    {
      "controlKey": "defender:storage-network-restriction",
      "title": "Defender: storage network access restricted (VNet rules / private link)",
      "match": {
        "source": "defender",
        "displayNameContainsAny": [
          "restrict network access",
          "private link"
        ]
      },
      "mappings": {
        "nist_800_53_r5": [
          "SC-7",
          "AC-4"
        ]
      }
    },
    {
      "controlKey": "defender:secure-transfer",
      "title": "Defender: secure transfer to storage accounts enabled",
      "match": {
        "source": "defender",
        "displayNameContains": "secure transfer"
      },
      "mappings": {
        "nist_800_53_r5": [
          "SC-8"
        ]
      }
    },
    {
      "controlKey": "defender:mfa-privileged",
      "title": "Defender: MFA on accounts with privileged permissions",
      "match": {
        "source": "defender",
        "displayNameContainsAll": [
          "owner permissions",
          "mfa"
        ]
      },
      "mappings": {
        "nist_800_53_r5": [
          "IA-2(1)"
        ]
      }
    }
  ]
}
